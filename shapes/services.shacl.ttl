@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix jansutra: <https://jansutra.in/vocab/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

jansutra:ServiceAccessRecordShape
    a sh:NodeShape ;
    sh:targetClass jansutra:ServiceAccessRecord ;

    sh:property [
        sh:path jansutra:hasServiceAccess ;
        sh:class jansutra:ServiceAccess ;
    ] .


jansutra:ServiceAccessShape
    a sh:NodeShape ;
    sh:targetClass jansutra:ServiceAccess ;

    sh:property [
        sh:path jansutra:accessType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:ServiceTypeConceptShape ;
        sh:message "Every ServiceAccess must have exactly one accessType from jansutra:ServiceTypeScheme." ;
    ] ;

    sh:property [
        sh:path jansutra:accessQuality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:AccessQualityConceptShape ;
        sh:message "Every ServiceAccess must have exactly one accessQuality from jansutra:AccessQualityScheme." ;
    ] ;

    sh:property [
        sh:path jansutra:distanceInKm ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxExclusive 200 ;
    ] .


jansutra:ServiceTypeConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:ServiceTypeScheme ;
    ] .

jansutra:AccessQualityConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:AccessQualityScheme ;
    ] .
