@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix jansutra: <https://jansutra.in/vocab/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

jansutra:EconomicRecordShape
    a sh:NodeShape ;
    sh:targetClass jansutra:EconomicRecord ;

    sh:property [
        sh:path jansutra:povertyStatus ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:PovertyStatusConceptShape ;
    ] ;

    sh:property [
        sh:path jansutra:occupationType ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:OccupationTypeConceptShape ;
    ] ;

    sh:property [
        sh:path jansutra:annualHouseholdIncome ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Annual household income must be a non-negative decimal." ;
    ] ;

    sh:property [
        sh:path jansutra:monthlyPerCapitaExpenditure ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:path jansutra:householdSize ;
        sh:maxCount 1 ;
        sh:datatype xsd:positiveInteger ;
        sh:maxInclusive 30 ;
        sh:message "Household size must be a positive integer ≤30." ;
    ] ;

    sh:property [
        sh:path jansutra:hasMGNREGACard ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .


jansutra:PovertyStatusConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:PovertyStatusScheme ;
    ] .

jansutra:OccupationTypeConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:OccupationTypeScheme ;
    ] .
