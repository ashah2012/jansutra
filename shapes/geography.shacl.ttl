@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix jansutra: <https://jansutra.in/vocab/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

jansutra:AdministrativeUnitShape
    a sh:NodeShape ;
    sh:targetClass jansutra:AdministrativeUnit ;

    sh:property [
        sh:path jansutra:adminLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:AdminLevelConceptShape ;
        sh:message "Every AdministrativeUnit must have exactly one adminLevel from jansutra:AdminLevelScheme." ;
    ] ;

    sh:property [
        sh:path jansutra:lgdCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "LGD code is mandatory and must be a non-empty string." ;
    ] ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Every AdministrativeUnit must have at least one skos:prefLabel." ;
    ] ;

    sh:property [
        sh:path jansutra:isRemoteArea ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;

    sh:property [
        sh:path jansutra:isPESAArea ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .


jansutra:AdminLevelConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:AdminLevelScheme ;
    ] .
