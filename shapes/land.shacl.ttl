@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix jansutra: <https://jansutra.in/vocab/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

jansutra:LandHoldingShape
    a sh:NodeShape ;
    sh:targetClass jansutra:LandHolding ;

    sh:property [
        sh:path jansutra:areaInHectares ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxExclusive 500 ;
        sh:message "Area must be a non-negative decimal less than 500 hectares (implausible values indicate data error)." ;
    ] ;

    sh:property [
        sh:path jansutra:landType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:LandTypeConceptShape ;
    ] ;

    sh:property [
        sh:path jansutra:tenureType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:TenureTypeConceptShape ;
    ] ;

    sh:property [
        sh:path jansutra:hasTitleDeed ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;

    sh:property [
        sh:path jansutra:holdingLocatedIn ;
        sh:maxCount 1 ;
        sh:class jansutra:AdministrativeUnit ;
    ] .


jansutra:LandTypeConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:LandTypeScheme ;
    ] .

jansutra:TenureTypeConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:TenureTypeScheme ;
    ] .
