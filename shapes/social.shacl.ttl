@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix jansutra: <https://jansutra.in/vocab/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

jansutra:SocialRecordShape
    a sh:NodeShape ;
    sh:targetClass jansutra:SocialRecord ;

    sh:property [
        sh:path jansutra:casteCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:CasteCategoryConceptShape ;
        sh:message "casteCategory must be exactly one concept from jansutra:CasteCategoryScheme." ;
    ] ;

    sh:property [
        sh:path jansutra:genderIdentity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:GenderIdentityConceptShape ;
        sh:message "genderIdentity must be exactly one concept from jansutra:GenderIdentityScheme." ;
    ] ;

    sh:property [
        sh:path jansutra:religion ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:node jansutra:ReligionConceptShape ;
    ] ;

    sh:property [
        sh:path jansutra:motherTongue ;
        sh:maxCount 1 ;
        sh:datatype xsd:language ;
    ] .


jansutra:CasteCategoryConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:CasteCategoryScheme ;
        sh:message "Caste concept must belong to jansutra:CasteCategoryScheme." ;
    ] .

jansutra:GenderIdentityConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:GenderIdentityScheme ;
        sh:message "Gender concept must belong to jansutra:GenderIdentityScheme." ;
    ] .

jansutra:ReligionConceptShape
    a sh:NodeShape ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:hasValue jansutra:ReligionScheme ;
    ] .
